DATABASE_URL=postgres://signs_of_life:signs_of_life@127.0.0.1:5432/signs_of_life
PUBLIC_URL=http://localhost:5173
AUTH_PROVIDER=better-auth
AUTH_SESSION_VERSION=1
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# JSON map; generate each 32-byte value with: openssl rand -base64 32
ENCRYPTION_KEYS=
ENCRYPTION_KEY_VERSION=v1
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SUPABASE_AUTH_URL=
SUPABASE_AUTH_KEY=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
EMAIL_PROVIDER=disabled
MAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_URL=smtp://localhost:1025
MAX_PROJECTS=5
MAX_SOURCES=10
MAX_DESTINATIONS=3
SOURCE_URL=https://github.com/arminayat/signs-of-life
BUILD_REVISION=development

# Isolated test database; its name must end in _test.
TEST_DATABASE_URL=postgres://signs_of_life:signs_of_life@127.0.0.1:5432/signs_of_life_test
