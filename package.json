{
  "name": "signs-of-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.5",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker 'pnpm dev:api' 'pnpm dev:web' 'pnpm dev:worker'",
    "dev:api": "tsx watch --env-file=.env apps/api/src/node.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "tsx watch --env-file=.env apps/jobs/src/node.ts",
    "build": "pnpm --dir packages/better-auth-connector build && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "auth:migrate": "tsx --env-file=.env scripts/migrate-identities.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@hono/node-server": "2.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.7.4",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "lucide-react": "1.44.0",
    "nodemailer": "10.0.3",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "svix": "2.4.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "prettier": "3.9.6",
    "smtp-server": "3.19.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  },
  "license": "AGPL-3.0-only"
}
